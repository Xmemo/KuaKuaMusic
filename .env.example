# Canonical MusicLearning2026 local Agent
CODEX_BIN=codex
# Optional overrides; blank uses gpt-6-luna with xhigh reasoning.
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=xhigh
CODEX_TIMEOUT_MS=360000
# Source discovery can take longer than drafting/review; still cancellable.
CODEX_RESEARCH_TIMEOUT_MS=720000
# Set to 0 to disable local evidence-package persistence.
MUSIC_LEARNING_PERSIST=1
# Optional custom location; default is .music-learning/evidence inside this repo.
# MUSIC_LEARNING_EVIDENCE_DIR=/absolute/path/to/evidence

# v2 target architecture. The current v1.2 route stays active until local audio E2E passes.
MUSIC_V2_ENABLED=0
# Each role is independently swappable.
MUSIC_LISTEN_PROVIDER=dashscope
MUSIC_LISTEN_MODEL=qwen3.5-omni-plus
MUSIC_RESEARCH_PROVIDER=dashscope
MUSIC_RESEARCH_MODEL=qwen3.5-omni-plus
MUSIC_RESEARCH_BACKEND=registered-web
MUSIC_CRITIC_PROVIDER=dashscope
MUSIC_CRITIC_MODEL=qwen3.5-omni-plus
MUSIC_CREATIVE_PROVIDER=dashscope
MUSIC_CREATIVE_MODEL=qwen3.5-omni-plus
# Cloud provider credentials are intentionally separate.
DASHSCOPE_API_KEY=
# Defaults below target Alibaba Cloud China (Beijing). Override together for another supported region/workspace.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_UPLOAD_URL=https://dashscope.aliyuncs.com/api/v1/uploads
SILICONFLOW_API_KEY=
# Local acquisition tools. v2 does not pass browser cookies or authentication to yt-dlp.
MUSIC_YTDLP_BIN=yt-dlp
MUSIC_FFMPEG_BIN=ffmpeg
# Optional custom v2 library location; default will be .music-learning/library.
# MUSIC_LIBRARY_DIR=/absolute/path/to/music-library

PROXY_PORT=8787
WEB_PORT=3000
# Optional: set when frontend and backend are not under the same origin.
# VITE_BACKEND_API_BASE_URL=http://127.0.0.1:8787

# Optional compatibility path. New UI and Agent are the defaults.
VITE_ENABLE_LEGACY_UI=0
MUSIC_LEARNING_ENABLE_LEGACY=0
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
