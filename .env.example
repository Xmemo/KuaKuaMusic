# Canonical MusicLearning2026 local Agent
CODEX_BIN=codex
# Optional overrides; blank uses gpt-6-luna with xhigh reasoning.
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=xhigh
CODEX_TIMEOUT_MS=360000
# Source discovery can take longer than drafting/review; still cancellable.
CODEX_RESEARCH_TIMEOUT_MS=720000
# Set to 0 to disable local evidence-package persistence.
MUSIC_LEARNING_PERSIST=1
# Optional custom location; default is .music-learning/evidence inside this repo.
# MUSIC_LEARNING_EVIDENCE_DIR=/absolute/path/to/evidence

# v4 browser bridge + Antigravity-native workflow.
# The browser prepares recording/run artifacts; Antigravity Desktop executes the custom agents.
MUSIC_V4_BRIDGE_ENABLED=0
VITE_MUSIC_V4_ENABLED=0
# Optional custom run location; default is .music-learning/runs.
# MUSIC_V4_RUNS_DIR=/absolute/path/to/music-runs
# Optional session-bus state location; default is .music-learning/session.
# MUSIC_V4_SESSION_DIR=/absolute/path/to/music-session

# v3 single-agent CLI architecture (reference/compatibility path)
MUSIC_V3_ENABLED=0
VITE_MUSIC_V3_ENABLED=0
# Thin Runner boundary: future multimodal agents can replace this without changing the Skill or artifact.
MUSIC_ANALYSIS_RUNNER=antigravity-cli
MUSIC_ANALYSIS_CLI_BIN=agy
MUSIC_ANALYSIS_MODEL=gemini-3.8-flash-high
MUSIC_ANALYSIS_EFFORT=high
MUSIC_ANALYSIS_TIMEOUT_MS=1200000
MUSIC_ANALYSIS_PRINT_TIMEOUT=20m
# v3 runs inside an isolated Song Package workspace. Auto-approval is paired with CLI sandbox mode.
MUSIC_ANALYSIS_AUTO_APPROVE=1

# v2 target architecture. The current v1.2 route stays active until local audio E2E passes.
MUSIC_V2_ENABLED=0
# Enable both server and frontend v2 only for local beta/E2E acceptance.
VITE_MUSIC_V2_ENABLED=0
# Each role is independently swappable.
MUSIC_LISTEN_PROVIDER=dashscope
MUSIC_LISTEN_MODEL=qwen3.8-omni-flash
MUSIC_RESEARCH_PROVIDER=dashscope
MUSIC_RESEARCH_MODEL=qwen3.8-omni-flash
MUSIC_RESEARCH_BACKEND=registered-web
# Reuse independent first-pass research for one week by default; set 0 to refresh every run.
MUSIC_RESEARCH_CACHE_TTL_HOURS=168
MUSIC_CRITIC_PROVIDER=dashscope
MUSIC_CRITIC_MODEL=qwen3.8-omni-flash
MUSIC_CREATIVE_PROVIDER=dashscope
MUSIC_CREATIVE_MODEL=qwen3.8-omni-flash
# Cloud provider credentials are intentionally separate.
DASHSCOPE_API_KEY=
# Defaults below target Alibaba Cloud China (Beijing). Override together for another supported region/workspace.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_UPLOAD_URL=https://dashscope.aliyuncs.com/api/v1/uploads
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Local acquisition tools. v2 does not pass browser cookies or authentication to yt-dlp.
MUSIC_YTDLP_BIN=yt-dlp
MUSIC_FFMPEG_BIN=ffmpeg
MUSIC_FFPROBE_BIN=ffprobe
# Optional custom v2 library location; default will be .music-learning/library.
# MUSIC_LIBRARY_DIR=/absolute/path/to/music-library

PROXY_PORT=8787
WEB_PORT=3000
# Optional: set when frontend and backend are not under the same origin.
# VITE_BACKEND_API_BASE_URL=http://127.0.0.1:8787

# Optional compatibility path. New UI and Agent are the defaults.
VITE_ENABLE_LEGACY_UI=0
MUSIC_LEARNING_ENABLE_LEGACY=0
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
