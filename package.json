{
  "name": "praisemysong-(教你夸一首歌)",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/proxy.mjs",
    "build": "vite build",
    "start": "node server/proxy.mjs",
    "preview": "vite preview",
    "start:api": "node server/proxy.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "licenses:generate": "node scripts/generate-notices.mjs",
    "workflow:v4:dsp-selftest": "python3 tools/music-dsp/audio_metrics.py --self-test"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "acorn": "8.17.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-or-later"
}
