{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicLearning2026 ResearchDraft v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "unknowns"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "text",
          "evidenceIds",
          "scope",
          "versionScope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "enum": [
              "identity",
              "culture",
              "harmony",
              "rhythm",
              "timbre",
              "arrangement",
              "structure",
              "production"
            ]
          },
          "text": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "work",
              "source_version",
              "recording"
            ]
          },
          "versionScope": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
