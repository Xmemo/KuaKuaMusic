{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicLearning Research Workflow v4 Listen Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "error",
    "audioDurationSec",
    "overallCharacter",
    "observations",
    "notableMoments",
    "uncertainties"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "failed"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "audioDurationSec": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "overallCharacter": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "text",
          "startSec",
          "endSec",
          "confidence",
          "precision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "rhythm",
              "harmony",
              "melody",
              "timbre",
              "arrangement",
              "structure",
              "production",
              "energy"
            ]
          },
          "text": {
            "type": "string"
          },
          "startSec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "endSec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "precision": {
            "type": "string",
            "enum": [
              "global",
              "section",
              "time_localized"
            ]
          }
        }
      }
    },
    "notableMoments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "startSec",
          "endSec",
          "observationIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startSec": {
            "type": "number",
            "minimum": 0
          },
          "endSec": {
            "type": "number",
            "minimum": 0
          },
          "observationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
