{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicLearning Research Workflow v4 Analysis Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "inputStatus",
    "overall",
    "interpretations",
    "modules",
    "unknowns",
    "studioPotential",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "inputStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listen",
        "dsp",
        "research"
      ],
      "properties": {
        "listen": {
          "type": "string",
          "enum": [
            "complete",
            "failed",
            "missing"
          ]
        },
        "dsp": {
          "type": "string",
          "enum": [
            "complete",
            "failed",
            "missing"
          ]
        },
        "research": {
          "type": "string",
          "enum": [
            "complete",
            "failed",
            "missing"
          ]
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "emo",
        "hype",
        "pro",
        "overallCharacter"
      ],
      "properties": {
        "hook": {
          "type": "string"
        },
        "emo": {
          "type": "string"
        },
        "hype": {
          "type": "string"
        },
        "pro": {
          "type": "string"
        },
        "overallCharacter": {
          "type": "string"
        }
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "text",
          "observationIds",
          "measurementIds",
          "evidenceIds",
          "generalPrinciples"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "culture",
              "rhythm",
              "harmony",
              "melody",
              "timbre",
              "arrangement",
              "structure",
              "production",
              "energy"
            ]
          },
          "text": {
            "type": "string"
          },
          "observationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "measurementIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generalPrinciples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "title",
          "summary",
          "interpretationIds",
          "listeningCues",
          "unknowns"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "culture",
              "rhythm",
              "harmony",
              "melody",
              "timbre",
              "arrangement",
              "structure",
              "production",
              "energy"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "interpretationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "listeningCues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "startSec",
                "endSec"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "startSec": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "endSec": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "studioPotential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "mechanism",
        "sourceInterpretationIds",
        "variable",
        "baseline",
        "changed",
        "listenFor",
        "limitation"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "mechanism": {
          "type": "string"
        },
        "sourceInterpretationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variable": {
          "type": "string"
        },
        "baseline": {
          "type": "string"
        },
        "changed": {
          "type": "string"
        },
        "listenFor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitation": {
          "type": "string"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
