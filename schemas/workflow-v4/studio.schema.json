{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicLearning Research Workflow v4 Studio Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceType",
    "analysisId",
    "sourceInterpretationIds",
    "question",
    "variable",
    "baseline",
    "changed",
    "constants",
    "listenFor",
    "limitation",
    "code",
    "alternativeCode",
    "visualHints"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.0"
    },
    "sourceType": {
      "const": "learning_reconstruction"
    },
    "analysisId": {
      "type": "string"
    },
    "sourceInterpretationIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": "string"
    },
    "variable": {
      "type": "string"
    },
    "baseline": {
      "type": "string"
    },
    "changed": {
      "type": "string"
    },
    "constants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "listenFor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitation": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "alternativeCode": {
      "type": "string"
    },
    "visualHints": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pianoroll",
          "punchcard",
          "spiral",
          "scope",
          "spectrum",
          "pitchwheel"
        ]
      }
    }
  }
}
