{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MusicLearning2026 Single-Agent Analysis Artifact v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "songId",
    "mediaRevisionId",
    "createdAt",
    "agent",
    "overall",
    "observations",
    "measurements",
    "externalEvidence",
    "interpretations",
    "modules",
    "unknowns",
    "creativeExperiment"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "analysisId": {
      "type": "string"
    },
    "songId": {
      "type": "string"
    },
    "mediaRevisionId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "model",
        "effort",
        "skill",
        "conversationId",
        "toolsUsed",
        "usage",
        "protocolChecks"
      ],
      "properties": {
        "runner": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "conversationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolsUsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputTokens",
            "outputTokens",
            "thinkingTokens",
            "cacheReadTokens",
            "totalTokens"
          ],
          "properties": {
            "inputTokens": {
              "type": [
                "number",
                "null"
              ]
            },
            "outputTokens": {
              "type": [
                "number",
                "null"
              ]
            },
            "thinkingTokens": {
              "type": [
                "number",
                "null"
              ]
            },
            "cacheReadTokens": {
              "type": [
                "number",
                "null"
              ]
            },
            "totalTokens": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "protocolChecks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "listenCheckpointExists",
            "noMcpDependency"
          ],
          "properties": {
            "listenCheckpointExists": {
              "type": "boolean"
            },
            "noMcpDependency": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "emo",
        "hype",
        "pro",
        "overallCharacter"
      ],
      "properties": {
        "hook": {
          "type": "string"
        },
        "emo": {
          "type": "string"
        },
        "hype": {
          "type": "string"
        },
        "pro": {
          "type": "string"
        },
        "overallCharacter": {
          "type": "string"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "text",
          "startSec",
          "endSec",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "rhythm",
              "harmony",
              "melody",
              "timbre",
              "arrangement",
              "structure",
              "production",
              "energy"
            ]
          },
          "text": {
            "type": "string"
          },
          "startSec": {
            "type": [
              "number",
              "null"
            ]
          },
          "endSec": {
            "type": [
              "number",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "value",
          "unit",
          "method",
          "confidence",
          "startSec",
          "endSec",
          "alternatives",
          "artifactPath",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "startSec": {
            "type": [
              "number",
              "null"
            ]
          },
          "endSec": {
            "type": [
              "number",
              "null"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "confidence"
              ],
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "artifactPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "externalEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "excerpt",
          "claim",
          "scope",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "work",
              "recording",
              "release",
              "artist",
              "general"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "text",
          "observationIds",
          "measurementIds",
          "evidenceIds",
          "generalPrinciples"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "culture",
              "rhythm",
              "harmony",
              "melody",
              "timbre",
              "arrangement",
              "structure",
              "production",
              "energy"
            ]
          },
          "text": {
            "type": "string"
          },
          "observationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "measurementIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generalPrinciples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "title",
          "summary",
          "interpretationIds",
          "listeningCues",
          "unknowns"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "culture",
              "rhythm",
              "harmony",
              "melody",
              "timbre",
              "arrangement",
              "structure",
              "production",
              "energy"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "interpretationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "listeningCues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "startSec",
                "endSec"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "startSec": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "endSec": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creativeExperiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "mechanism",
        "sourceInterpretationIds",
        "variable",
        "baseline",
        "changed",
        "constants",
        "listenFor",
        "code",
        "alternativeCode",
        "visualHints",
        "limitation"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "mechanism": {
          "type": "string"
        },
        "sourceInterpretationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variable": {
          "type": "string"
        },
        "baseline": {
          "type": "string"
        },
        "changed": {
          "type": "string"
        },
        "constants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "listenFor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternativeCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "visualHints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pianoroll",
              "punchcard",
              "spiral",
              "scope",
              "spectrum",
              "pitchwheel"
            ]
          }
        },
        "limitation": {
          "type": "string"
        }
      }
    }
  }
}
